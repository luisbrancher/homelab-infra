# Gerenciado pelo Ansible — não editar manualmente

global:
  # intervalo padrão de coleta de métricas
  scrape_interval: 15s
  # intervalo de avaliação de alertas
  evaluation_interval: 15s

# para onde mandar os alertas que estão firing (Alertmanager na mesma LXC)
alerting:
  alertmanagers:
    - static_configs:
        - targets: ["localhost:{{ alertmanager_port }}"]

# regras avaliadas a cada evaluation_interval (template alert.rules.yml.j2)
rule_files:
  - /etc/prometheus/alert.rules.yml

scrape_configs:

  # o próprio Prometheus se monitora
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  # o Alertmanager também expõe métricas (alertas recebidos, notificações que falharam)
  - job_name: "alertmanager"
    static_configs:
      - targets: ["localhost:{{ alertmanager_port }}"]

  # métricas do k3s-node
  - job_name: "k3s-node"
    static_configs:
      - targets: ["{{ hostvars['k3s-node']['ansible_host'] }}:9100"]

  # métricas do lxc-monitoring
  - job_name: "lxc-monitoring"
    static_configs:
      - targets: ["localhost:9100"]

  # métricas do pi4
  - job_name: "pi4"
    static_configs:
      - targets: ["{{ hostvars['pi4']['ansible_host'] }}:9100"]

  # métricas do forgejo
  - job_name: "forgejo"
    static_configs:
      - targets: ["{{ hostvars['forgejo']['ansible_host'] }}:9100"]

  # truenas - SNMP exporter a configurar futuramente
  # - job_name: "truenas"
  #   static_configs:
  #     - targets: ["{{ hostvars['truenas']['ansible_host'] }}:9100"]